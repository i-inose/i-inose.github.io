---
import LinkGroups from './LinkGroups.astro';
import { SITE } from '../config/site';
import { localePath, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <LinkGroups lang={lang} compact />
    <div class="bottom">
      <a href={localePath(lang, '/contact/')}>{t(lang, 'footer.contact')}</a>
      <small>© {year} {SITE.name.en}</small>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    padding: 32px 0 40px;
  }

  .bottom {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px;
    margin-top: 24px;
    font-size: 0.88rem;
  }

  small {
    color: var(--subtle);
    font-size: 0.8rem;
  }
</style>

---
import type { CollectionEntry } from 'astro:content';
import { formatDate, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  items: CollectionEntry<'news'>[];
  showBody?: boolean;
}

const { lang, items, showBody = true } = Astro.props;
---

<ul class="news-list">
  {
    items.map((item) => (
      <li>
        <time class="date" datetime={item.data.date.toISOString().slice(0, 10)}>
          {formatDate(item.data.date, lang)}
        </time>
        <div>
          <h3 class="title">
            {item.data.link ? (
              <a href={item.data.link} target="_blank" rel="noopener">
                {item.data.title[lang]}
              </a>
            ) : (
              item.data.title[lang]
            )}
          </h3>
          {showBody && item.data.body && <p class="body muted">{item.data.body[lang]}</p>}
        </div>
      </li>
    ))
  }
</ul>

<style>
  .news-list {
    list-style: none;
    display: grid;
    gap: 20px;
  }

  li {
    display: grid;
    gap: 2px;
  }

  .title {
    font-size: 1rem;
    font-weight: 600;
  }

  .body {
    margin: 4px 0 0;
    font-size: 0.92rem;
  }

  @media (min-width: 720px) {
    li {
      grid-template-columns: 8.5rem 1fr;
      gap: 16px;
    }

    .date {
      padding-top: 2px;
    }
  }
</style>
